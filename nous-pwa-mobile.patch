+"use client";
+// Tab bar native : 4 onglets + bouton central « + » (nouveau souvenir).
+// 7 onglets ne tenaient pas sur un téléphone (labels tronqués, cibles
+// de 50 px) → les sections secondaires sont regroupées dans « Plus ».
+
+import Link from "next/link";
+import { usePathname } from "next/navigation";
+import type { ReactNode } from "react";
+import { useUiStore } from "@/store/uiStore";
+import { haptic } from "@/lib/device";
+import { COUPLE_GRADIENT } from "@/lib/couple";
+
+const ACTIVE = "#FFFFFF";
+const INACTIVE = "#8E8E93";
+
+type Tab = { href: string; label: string; match: string[]; icon: (a: boolean) => ReactNode };
+
+const stroke = (a: boolean) => ({
+  width: 26,
+  height: 26,
+  viewBox: "0 0 24 24",
+  fill: "none",
+  stroke: a ? ACTIVE : INACTIVE,
+  strokeWidth: 1.8,
+  strokeLinecap: "round" as const,
+  strokeLinejoin: "round" as const,
+  "aria-hidden": true,
+});
+
+const LEFT: Tab[] = [
+  {
+    href: "/home",
+    label: "Accueil",
+    match: ["/home", "/memory"],
+    icon: (a) => (
+      <svg {...stroke(a)} fill={a ? ACTIVE : "none"}>
+        <path d="M3 9.5 12 3l9 6.5V20a1 1 0 0 1-1 1h-5v-6h-6v6H4a1 1 0 0 1-1-1V9.5z" />
+      </svg>
+    ),
+  },
+  {
+    href: "/map",
+    label: "Carte",
+    match: ["/map"],
+    icon: (a) => (
+      <svg {...stroke(a)}>
+        <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z" fill={a ? ACTIVE : "none"} />
+        <circle cx="12" cy="10" r="3" fill={a ? "#000" : "none"} stroke={a ? "#000" : INACTIVE} />
+      </svg>
+    ),
+  },
+];
+
+const RIGHT: Tab[] = [
+  {
+    href: "/stats",
+    label: "Histoire",
+    match: ["/stats"],
+    icon: (a) => (
+      <svg {...stroke(a)} fill={a ? ACTIVE : "none"}>
+        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
+      </svg>
+    ),
+  },
+  {
+    href: "/plus",
+    label: "Plus",
+    match: ["/plus", "/gifts", "/bucketlist", "/capsule", "/resto"],
+    icon: (a) => (
+      <svg {...stroke(a)}>
+        <rect x="3.5" y="3.5" width="7" height="7" rx="2" fill={a ? ACTIVE : "none"} />
+        <rect x="13.5" y="3.5" width="7" height="7" rx="2" fill={a ? ACTIVE : "none"} />
+        <rect x="3.5" y="13.5" width="7" height="7" rx="2" fill={a ? ACTIVE : "none"} />
+        <rect x="13.5" y="13.5" width="7" height="7" rx="2" fill={a ? ACTIVE : "none"} />
+      </svg>
+    ),
+  },
+];
+
+function TabLink({ tab, active }: { tab: Tab; active: boolean }) {
+  return (
+    <li style={{ flex: 1, minWidth: 0 }}>
+      <Link
+        href={tab.href}
+        aria-current={active ? "page" : undefined}
+        onClick={() => !active && haptic(6)}
+        className="tap"
+        style={{
+          height: "var(--tabbar-h)",
+          display: "flex",
+          flexDirection: "column",
+          alignItems: "center",
+          justifyContent: "center",
+          gap: 2,
+          textDecoration: "none",
+        }}
+      >
+        {tab.icon(active)}
+        <span style={{ fontSize: 10.5, lineHeight: 1.1, fontWeight: active ? 600 : 500, color: active ? ACTIVE : INACTIVE, letterSpacing: 0.1 }}>
+          {tab.label}
+        </span>
+      </Link>
+    </li>
+  );
+}
+
+export default function TabBar() {
+  const pathname = usePathname() ?? "";
+  const openAdd = useUiStore((s) => s.openAddMemory);
+  const isActive = (t: Tab) => t.match.some((m) => pathname === m || pathname.startsWith(`${m}/`));
+
+  return (
+    <nav
+      aria-label="Navigation principale"
+      style={{
+        position: "fixed",
+        left: 0,
+        right: 0,
+        bottom: 0,
+        zIndex: 90,
+        paddingBottom: "max(var(--safe-bottom), 8px)",
+        paddingLeft: "var(--safe-left)",
+        paddingRight: "var(--safe-right)",
+        background: "rgba(18,18,20,0.88)",
+        backdropFilter: "saturate(180%) blur(24px)",
