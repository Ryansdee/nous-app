+        </Field>
+        <Field label="Catégorie">
+          <div style={{ display: "grid", gridTemplateColumns: "repeat(4, 1fr)", gap: 8 }}>
+            {CATEGORIES.map((k) => {
+              const active = formCat === k.key;
+              return (
+                <button
+                  key={k.key}
+                  type="button"
+                  aria-pressed={active}
+                  onClick={() => {
+                    haptic(6);
+                    setFormCat(k.key);
