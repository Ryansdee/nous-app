+        borderTop: "0.5px solid rgba(255,255,255,0.1)",
+      }}
+    >
+      <ul style={{ listStyle: "none", margin: "0 auto", maxWidth: 560, display: "flex", alignItems: "stretch" }}>
+        {LEFT.map((t) => (
+          <TabLink key={t.href} tab={t} active={isActive(t)} />
+        ))}
+
+        <li style={{ flex: 1, display: "flex", alignItems: "center", justifyContent: "center" }}>
+          <button
+            type="button"
+            onClick={() => {
+              haptic(10);
+              openAdd();
+            }}
+            aria-label="Nouveau souvenir"
+            className="tap"
+            style={{
+              width: 50,
+              height: 50,
+              borderRadius: "50%",
+              border: "none",
+              cursor: "pointer",
+              background: COUPLE_GRADIENT,
+              color: "#FFF",
+              display: "flex",
+              alignItems: "center",
+              justifyContent: "center",
+              boxShadow: "0 4px 14px rgba(255,45,85,0.35)",
+            }}
+          >
+            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.8" strokeLinecap="round" aria-hidden="true">
+              <path d="M12 5v14M5 12h14" />
+            </svg>
+          </button>
+        </li>
+
+        {RIGHT.map((t) => (
+          <TabLink key={t.href} tab={t} active={isActive(t)} />
+        ))}
+      </ul>
+    </nav>
+  );
+}
