+                    </div>
+                  )}
+                  <div style={{ display: "flex", alignItems: "center", gap: 6, padding: "6px 4px 6px 4px" }}>
+                    <button
+                      type="button"
+                      onClick={() => {
+                        if (item.done) handleUndo(item);
