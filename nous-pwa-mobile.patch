+        background: "rgba(0,0,0,0.92)",
+        backdropFilter: "saturate(180%) blur(20px)",
+        WebkitBackdropFilter: "saturate(180%) blur(20px)",
+        borderBottom: bare ? "none" : `0.5px solid ${c.separator}`,
+      }}
+    >
+      {back && (
+        <Link
+          href={back.href}
+          className="tap"
+          style={{
+            display: "inline-flex",
+            alignItems: "center",
+            gap: 2,
+            minHeight: 44,
+            marginLeft: -8,
+            paddingRight: 12,
+            color: c.link,
+            fontSize: 17,
+            textDecoration: "none",
+          }}
+        >
+          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.4" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
+            <path d="m15 18-6-6 6-6" />
+          </svg>
+          {back.label}
+        </Link>
+      )}
+
+      <div style={{ display: "flex", alignItems: "flex-end", justifyContent: "space-between", gap: 8 }}>
+        <div style={{ minWidth: 0, flex: 1 }}>
+          {eyebrow && (
+            <p style={{ fontSize: 12, color: c.text3, textTransform: "uppercase", fontWeight: 600, letterSpacing: 0.5, marginBottom: 2 }}>
+              {eyebrow}
+            </p>
+          )}
+          <h1
+            style={{
+              fontFamily: font.serif,
+              fontSize: 30,
+              fontWeight: 600,
+              letterSpacing: -0.5,
+              lineHeight: 1.1,
+              color: c.text,
+              overflow: "hidden",
+              textOverflow: "ellipsis",
+              whiteSpace: "nowrap",
+            }}
+          >
+            {title}
+          </h1>
+          {subtitle && <p style={{ fontSize: 13, color: c.text3, marginTop: 3 }}>{subtitle}</p>}
+        </div>
+        {right && <div style={{ display: "flex", alignItems: "center", gap: 2, marginRight: -6, flexShrink: 0 }}>{right}</div>}
+      </div>
+
+      {children && <div style={{ marginTop: 12 }}>{children}</div>}
+    </header>
+  );
+}
diff --git a/src/components/ui/Screen.tsx b/src/components/ui/Screen.tsx
new file mode 100644
index 0000000..0b1aaa6
--- /dev/null
+++ b/src/components/ui/Screen.tsx
@@ -0,0 +1,172 @@
+"use client";
+// Squelette d'un écran : en-tête fixe + zone scrollable qui s'arrête
+// au-dessus de la tab bar. Option : tirer pour rafraîchir (absent
+// nativement dans une PWA iOS installée).
+
+import { useEffect, useRef, useState, type CSSProperties, type ReactNode } from "react";
+import { haptic } from "@/lib/device";
+
+type Props = {
+  header?: ReactNode;
+  children: ReactNode;
+  onRefresh?: () => Promise<unknown> | void;
+  /** Style du contenu (padding…) */
+  contentStyle?: CSSProperties;
+  /** Animation d'entrée : "fade" (onglet) ou "push" (sous-page) */
+  transition?: "fade" | "push";
+};
+
+const TRIGGER = 70;
+const MAX_PULL = 110;
+
+export default function Screen({ header, children, onRefresh, contentStyle, transition = "fade" }: Props) {
+  const scrollRef = useRef<HTMLDivElement>(null);
+  const innerRef = useRef<HTMLDivElement>(null);
+  const [pull, setPull] = useState(0);
+  const [refreshing, setRefreshing] = useState(false);
+  const refreshRef = useRef(onRefresh);
+  useEffect(() => {
+    refreshRef.current = onRefresh;
+  }, [onRefresh]);
+  const busy = useRef(false);
+
+  useEffect(() => {
+    const el = scrollRef.current;
+    if (!el || !onRefresh) return;
+    let startY = 0;
+    let startX = 0;
+    let active = false;
+    let decided = false;
+    let dist = 0;
+    let buzzed = false;
+
+    const onStart = (e: TouchEvent) => {
+      if (busy.current || el.scrollTop > 0) {
+        active = false;
+        return;
+      }
+      startY = e.touches[0].clientY;
+      startX = e.touches[0].clientX;
+      active = true;
+      decided = false;
+      dist = 0;
+      buzzed = false;
+    };
+    const onMove = (e: TouchEvent) => {
+      if (!active) return;
+      const dy = e.touches[0].clientY - startY;
+      const dx = e.touches[0].clientX - startX;
+      if (!decided) {
+        if (Math.abs(dy) < 6 && Math.abs(dx) < 6) return;
+        decided = true;
+        if (dy <= 0 || Math.abs(dx) > Math.abs(dy) || el.scrollTop > 0) {
+          active = false;
+          return;
+        }
+      }
+      if (dy <= 0) {
+        dist = 0;
+        setPull(0);
+        return;
+      }
+      e.preventDefault();
+      dist = Math.min(MAX_PULL, dy * 0.5);
+      if (dist >= TRIGGER && !buzzed) {
+        buzzed = true;
+        haptic(10);
+      }
+      setPull(dist);
+    };
+    const onEnd = async () => {
+      if (!active) return;
+      active = false;
+      if (dist >= TRIGGER && refreshRef.current) {
+        busy.current = true;
+        setRefreshing(true);
+        setPull(56);
+        try {
+          await refreshRef.current();
+        } finally {
+          busy.current = false;
+          setRefreshing(false);
+          setPull(0);
+        }
+      } else {
+        setPull(0);
+      }
+    };
+    el.addEventListener("touchstart", onStart, { passive: true });
+    el.addEventListener("touchmove", onMove, { passive: false });
+    el.addEventListener("touchend", onEnd);
+    el.addEventListener("touchcancel", onEnd);
+    return () => {
+      el.removeEventListener("touchstart", onStart);
+      el.removeEventListener("touchmove", onMove);
+      el.removeEventListener("touchend", onEnd);
+      el.removeEventListener("touchcancel", onEnd);
+    };
+  }, [onRefresh]);
+
+  const progress = Math.min(1, pull / TRIGGER);
+
+  return (
+    <div
+      className={transition === "push" ? "push-in" : "screen-in"}
+      style={{ height: "100%", display: "flex", flexDirection: "column", background: "#000", overflow: "hidden" }}
+    >
+      {header}
+      <div ref={scrollRef} className="scroll-y" style={{ flex: 1, minHeight: 0, position: "relative" }}>
+        {onRefresh && (
+          <div
+            aria-hidden={!refreshing}
+            role={refreshing ? "status" : undefined}
+            style={{
+              position: "absolute",
+              top: 0,
+              left: 0,
+              right: 0,
+              height: pull,
+              display: "flex",
+              alignItems: "center",
+              justifyContent: "center",
+              overflow: "hidden",
+              pointerEvents: "none",
+            }}
+          >
+            {refreshing ? (
+              <>
+                <span className="spinner" />
+                <span className="sr-only">Actualisation…</span>
+              </>
+            ) : (
+              <svg
+                width="22"
+                height="22"
+                viewBox="0 0 24 24"
+                fill="none"
+                stroke="#8E8E93"
+                strokeWidth="2.5"
+                strokeLinecap="round"
+                strokeLinejoin="round"
+                style={{ opacity: progress, transform: `rotate(${progress >= 1 ? 180 : 0}deg)`, transition: "transform .2s" }}
+              >
+                <path d="M12 5v14M5 12l7 7 7-7" />
+              </svg>
+            )}
+          </div>
+        )}
+        <div
+          ref={innerRef}
+          style={{
+            transform: pull ? `translateY(${pull}px)` : undefined,
+            transition: pull === 0 || refreshing ? "transform .3s cubic-bezier(.2,.8,.2,1)" : "none",
+            paddingBottom: "calc(var(--tabbar-space) + 28px)",
+            ...contentStyle,
+          }}
+        >
+          {children}
+        </div>
+      </div>
+    </div>
+  );
+}
diff --git a/src/components/ui/Sheet.tsx b/src/components/ui/Sheet.tsx
new file mode 100644
index 0000000..70d0bb8
--- /dev/null
+++ b/src/components/ui/Sheet.tsx
@@ -0,0 +1,296 @@
+"use client";
+// Bottom sheet façon iOS :
+// - glisser vers le bas (poignée, en-tête, ou contenu déjà en haut) pour fermer
+// - suit le clavier (visualViewport) → le bouton d'action reste visible
+// - verrouille le scroll derrière, Échap pour fermer, focus géré
+// - rendu dans un portal → toujours au-dessus de la tab bar
+
+import { useCallback, useEffect, useId, useRef, useState, type ReactNode } from "react";
+import { createPortal } from "react-dom";
+import { c, iconButton } from "@/lib/tokens";
+
+type Props = {
+  open: boolean;
+  onClose: () => void;
+  title?: ReactNode;
+  /** Petit texte au-dessus du titre */
+  eyebrow?: ReactNode;
+  children: ReactNode;
+  /** Zone collée en bas (bouton principal) — reste au-dessus du clavier */
+  footer?: ReactNode;
+  /** "auto" = hauteur du contenu ; "full" = quasi plein écran (formulaires longs) */
+  size?: "auto" | "full";
+  /** Empêche la fermeture (pendant un envoi par ex.) */
+  locked?: boolean;
+};
+
+const CLOSE_DISTANCE = 110;
+
+export default function Sheet({ open, onClose, title, eyebrow, children, footer, size = "auto", locked = false }: Props) {
+  const [mounted, setMounted] = useState(open);
+  const [closing, setClosing] = useState(false);
+  const [entered, setEntered] = useState(false);
+  const [kb, setKb] = useState(0);
+  const [vh, setVh] = useState<number | null>(null);
+  const panelRef = useRef<HTMLDivElement>(null);
+  const bodyRef = useRef<HTMLDivElement>(null);
+  const lastFocus = useRef<HTMLElement | null>(null);
+  const titleId = useId();
+  const lockedRef = useRef(locked);
+  useEffect(() => {
+    lockedRef.current = locked;
+  }, [locked]);
+
+  // Montage / démontage avec animation de sortie (état dérivé de `open`)
+  const [prevOpen, setPrevOpen] = useState(open);
+  if (open !== prevOpen) {
+    setPrevOpen(open);
+    if (open) {
+      setMounted(true);
+      setClosing(false);
+      setEntered(false);
+    } else if (mounted) {
+      setClosing(true);
+    }
+  }
+
+  useEffect(() => {
+    if (open) lastFocus.current = document.activeElement as HTMLElement | null;
+  }, [open]);
+
+  useEffect(() => {
+    if (!closing) return;
+    const t = setTimeout(() => {
+      setMounted(false);
+      setClosing(false);
+      lastFocus.current?.focus?.();
+    }, 240);
+    return () => clearTimeout(t);
+  }, [closing]);
+
+  const requestClose = useCallback(() => {
+    if (!lockedRef.current) onClose();
+  }, [onClose]);
+
+  // Focus + Échap
+  useEffect(() => {
+    if (!mounted || closing) return;
+    const t = setTimeout(() => panelRef.current?.focus({ preventScroll: true }), 30);
+    const onKey = (e: KeyboardEvent) => e.key === "Escape" && requestClose();
+    window.addEventListener("keydown", onKey);
+    return () => {
+      clearTimeout(t);
+      window.removeEventListener("keydown", onKey);
+    };
+  }, [mounted, closing, requestClose]);
+
+  // Clavier virtuel : on remonte la feuille de la hauteur du clavier
+  useEffect(() => {
+    if (!mounted) return;
+    const vv = window.visualViewport;
+    if (!vv) return;
+    const update = () => {
+      const inset = Math.max(0, window.innerHeight - vv.height - vv.offsetTop);
+      setKb(inset > 80 ? inset : 0);
+      setVh(vv.height);
+    };
+    update();
+    vv.addEventListener("resize", update);
+    vv.addEventListener("scroll", update);
+    return () => {
+      vv.removeEventListener("resize", update);
+      vv.removeEventListener("scroll", update);
+    };
+  }, [mounted]);
+
+  // Glisser pour fermer (listeners natifs non-passifs)
+  useEffect(() => {
+    const panel = panelRef.current;
+    if (!mounted || !panel) return;
+    let startY = 0;
+    let startX = 0;
+    let dy = 0;
+    let dragging = false;
+    let decided = false;
+    let allowed = false;
+
+    const onStart = (e: TouchEvent) => {
+      const target = e.target as HTMLElement;
+      const inBody = bodyRef.current?.contains(target);
+      // Depuis le contenu : seulement si celui-ci est déjà tout en haut
+      allowed = !inBody || (bodyRef.current?.scrollTop ?? 0) <= 0;
+      if (target.closest("input, textarea, select, [data-no-drag]")) allowed = false;
+      startY = e.touches[0].clientY;
+      startX = e.touches[0].clientX;
+      dy = 0;
+      dragging = false;
+      decided = false;
+    };
+    const onMove = (e: TouchEvent) => {
+      if (!allowed || lockedRef.current) return;
+      const y = e.touches[0].clientY - startY;
+      const x = e.touches[0].clientX - startX;
+      if (!decided) {
+        if (Math.abs(y) < 6 && Math.abs(x) < 6) return;
+        decided = true;
+        dragging = y > 0 && Math.abs(y) > Math.abs(x);
+        if (dragging) {
+          (document.activeElement as HTMLElement | null)?.blur?.();
+        }
+      }
+      if (!dragging) return;
+      e.preventDefault();
+      dy = Math.max(0, y);
+      panel.style.transition = "none";
+      panel.style.transform = `translateY(${dy}px)`;
+    };
+    const onEnd = () => {
+      if (!dragging) return;
+      dragging = false;
+      if (dy > CLOSE_DISTANCE) {
+        panel.style.setProperty("--drag", `${dy}px`);
+        requestClose();
+      } else {
+        panel.style.transition = "transform .25s cubic-bezier(.2,.8,.2,1)";
+        panel.style.transform = "translateY(0)";
+      }
+    };
+    panel.addEventListener("touchstart", onStart, { passive: true });
+    panel.addEventListener("touchmove", onMove, { passive: false });
+    panel.addEventListener("touchend", onEnd);
+    panel.addEventListener("touchcancel", onEnd);
+    return () => {
+      panel.removeEventListener("touchstart", onStart);
+      panel.removeEventListener("touchmove", onMove);
+      panel.removeEventListener("touchend", onEnd);
+      panel.removeEventListener("touchcancel", onEnd);
+    };
+  }, [mounted, requestClose]);
+
+  // Réinitialise la position quand on ré-ouvre
+  useEffect(() => {
+    if (open && panelRef.current) {
+      panelRef.current.style.transform = "";
+      panelRef.current.style.transition = "";
+      panelRef.current.style.removeProperty("--drag");
+    }
+  }, [open]);
+
+  if (!mounted || typeof document === "undefined") return null;
+
+  const available = (vh ?? (typeof window !== "undefined" ? window.innerHeight : 800));
+  const maxH = kb > 0 ? available - 8 : `calc(100dvh - var(--safe-top) - 24px)`;
+
+  return createPortal(
+    <div style={{ position: "fixed", inset: 0, zIndex: 1000 }}>
+      {/* Fond */}
+      <div
+        onClick={requestClose}
+        aria-hidden="true"
+        style={{
+          position: "absolute",
+          inset: 0,
+          background: "rgba(0,0,0,0.6)",
+          animation: `${closing ? "fade-out" : "fade-in"} .24s ease both`,
+        }}
+      />
+
+      {/* Panneau */}
+      <div
+        ref={panelRef}
+        role="dialog"
+        aria-modal="true"
+        aria-labelledby={title ? titleId : undefined}
+        tabIndex={-1}
+        onAnimationEnd={(e) => {
+          if (e.target === e.currentTarget && !closing) setEntered(true);
+        }}
+        style={{
+          position: "absolute",
+          left: 0,
+          right: 0,
+          bottom: kb,
+          margin: "0 auto",
+          maxWidth: 640,
+          height: size === "full" && kb === 0 ? maxH : undefined,
+          maxHeight: maxH,
+          display: "flex",
+          flexDirection: "column",
+          background: c.card,
+          borderRadius: kb > 0 ? 18 : "18px 18px 0 0",
+          boxShadow: "0 -10px 40px rgba(0,0,0,0.5)",
+          outline: "none",
+          // L'animation d'entrée est retirée une fois finie, sinon son
+          // « fill » écraserait le transform appliqué pendant le drag.
+          animation: closing
+            ? "sheet-down .24s cubic-bezier(.4,0,1,1) both"
+            : entered
+              ? "none"
+              : "sheet-up .32s cubic-bezier(.2,.8,.2,1) both",
+          transition: "bottom .2s ease",
+        }}
+      >
+        {/* Poignée + en-tête (zone de drag) */}
+        <div style={{ flexShrink: 0, padding: "8px 8px 0", touchAction: "none" }}>
+          <div aria-hidden="true" style={{ width: 38, height: 5, borderRadius: 3, background: "#48484A", margin: "0 auto 6px" }} />
+          {(title || eyebrow) && (
+            <div style={{ display: "flex", alignItems: "center", gap: 8, padding: "4px 8px 10px 12px" }}>
+              <div style={{ flex: 1, minWidth: 0 }}>
+                {eyebrow && (
+                  <p style={{ fontSize: 12, fontWeight: 700, letterSpacing: 0.5, textTransform: "uppercase", color: c.text3, marginBottom: 2 }}>
+                    {eyebrow}
+                  </p>
+                )}
+                {title && (
+                  <h2 id={titleId} style={{ fontSize: 20, fontWeight: 700, letterSpacing: -0.3, color: c.text }}>
+                    {title}
+                  </h2>
+                )}
+              </div>
+              <button
+                type="button"
+                onClick={requestClose}
+                disabled={locked}
+                aria-label="Fermer"
+                className="tap"
+                style={{ ...iconButton, width: 32, height: 32, background: c.card2, color: c.text2, margin: 6 }}
+              >
+                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="3" strokeLinecap="round" aria-hidden="true">
+                  <path d="M18 6 6 18M6 6l12 12" />
+                </svg>
+              </button>
+            </div>
+          )}
+        </div>
+
+        {/* Contenu scrollable */}
+        <div
+          ref={bodyRef}
+          className="scroll-y"
+          style={{
+            flex: "1 1 auto",
+            minHeight: 0,
+            padding: footer ? "4px 20px 12px" : `4px 20px calc(${kb > 0 ? "0px" : "var(--safe-bottom)"} + 24px)`,
+          }}
+        >
+          {children}
+        </div>
+
+        {footer && (
+          <div
+            style={{
+              flexShrink: 0,
+              padding: `10px 20px calc(${kb > 0 ? "0px" : "var(--safe-bottom)"} + 14px)`,
+              borderTop: `0.5px solid ${c.separator}`,
+              background: c.card,
+              borderRadius: kb > 0 ? "0 0 18px 18px" : 0,
+            }}
+          >
+            {footer}
+          </div>
+        )}
+      </div>
+    </div>,
+    document.body
+  );
+}
diff --git a/src/components/ui/kit.tsx b/src/components/ui/kit.tsx
new file mode 100644
index 0000000..3acb79a
--- /dev/null
+++ b/src/components/ui/kit.tsx
@@ -0,0 +1,232 @@
+"use client";
+// Petites briques UI partagées : contrôle segmenté, chips, état vide,
+// squelettes, bouton icône « + », champ de formulaire.
+
+import type { CSSProperties, ReactNode } from "react";
+import { c, iconButton, input as inputStyle, label as labelStyle } from "@/lib/tokens";
+import { haptic } from "@/lib/device";
+
+/* ── Contrôle segmenté iOS ───────────────────────────────────── */
+export function Segmented<T extends string>({
+  value,
+  onChange,
+  options,
+  label,
+}: {
+  value: T;
+  onChange: (v: T) => void;
+  options: { value: T; label: ReactNode }[];
+  label: string;
+}) {
+  const idx = Math.max(0, options.findIndex((o) => o.value === value));
+  return (
+    <div
+      role="tablist"
+      aria-label={label}
+      style={{ position: "relative", display: "flex", background: "#1C1C1E", borderRadius: 10, padding: 2 }}
+    >
+      <span
+        aria-hidden="true"
+        style={{
+          position: "absolute",
+          top: 2,
+          bottom: 2,
+          left: 2,
+          width: `calc((100% - 4px) / ${options.length})`,
+          transform: `translateX(${idx * 100}%)`,
+          background: "#636366",
+          borderRadius: 8,
+          boxShadow: "0 2px 6px rgba(0,0,0,0.3)",
+          transition: "transform .25s cubic-bezier(.2,.8,.2,1)",
+        }}
+      />
+      {options.map((o) => {
+        const active = o.value === value;
+        return (
+          <button
+            key={o.value}
+            type="button"
+            role="tab"
+            aria-selected={active}
+            onClick={() => {
+              if (!active) haptic(6);
+              onChange(o.value);
+            }}
+            style={{
+              position: "relative",
+              flex: 1,
+              minHeight: 34,
+              border: "none",
+              background: "transparent",
+              color: "#FFF",
+              fontSize: 14,
+              fontWeight: active ? 600 : 500,
+              cursor: "pointer",
+              borderRadius: 8,
+              whiteSpace: "nowrap",
+              overflow: "hidden",
+              textOverflow: "ellipsis",
+              padding: "0 6px",
+            }}
+          >
+            {o.label}
+          </button>
+        );
+      })}
+    </div>
+  );
+}
+
+/* ── Chips horizontales (filtres) ─────────────────────────────── */
+export function Chips<T extends string>({
+  value,
+  onChange,
+  options,
+  label,
+}: {
+  value: T;
+  onChange: (v: T) => void;
+  options: { value: T; label: ReactNode }[];
+  label: string;
+}) {
+  return (
+    <div role="group" aria-label={label} className="scroll-x" style={{ display: "flex", gap: 8, margin: "0 -16px", padding: "0 16px" }}>
+      {options.map((o) => {
+        const active = o.value === value;
+        return (
+          <button
+            key={o.value}
+            type="button"
+            aria-pressed={active}
+            className="tap"
+            onClick={() => {
+              haptic(6);
+              onChange(o.value);
+            }}
+            style={{
+              flexShrink: 0,
+              minHeight: 36,
+              padding: "0 14px",
+              borderRadius: 999,
+              border: "none",
+              background: active ? "#FFF" : c.card,
+              color: active ? "#000" : c.text2,
+              fontSize: 14,
+              fontWeight: active ? 600 : 500,
+              cursor: "pointer",
+              whiteSpace: "nowrap",
+            }}
+          >
+            {o.label}
+          </button>
+        );
+      })}
+    </div>
+  );
+}
+
+/* ── État vide ────────────────────────────────────────────────── */
+export function EmptyState({ icon, title, text, action }: { icon?: ReactNode; title: string; text?: string; action?: ReactNode }) {
+  return (
+    <div style={{ textAlign: "center", padding: "48px 24px", display: "flex", flexDirection: "column", alignItems: "center", gap: 6 }}>
+      {icon && <div aria-hidden="true" style={{ fontSize: 40, marginBottom: 6 }}>{icon}</div>}
+      <p style={{ fontSize: 17, color: c.text, fontWeight: 600 }}>{title}</p>
+      {text && <p style={{ fontSize: 15, color: c.text3, lineHeight: 1.45, maxWidth: 280 }}>{text}</p>}
+      {action && <div style={{ marginTop: 14 }}>{action}</div>}
+    </div>
+  );
+}
+
+/* ── Squelettes ───────────────────────────────────────────────── */
+export function SkeletonList({ rows = 4, height = 72 }: { rows?: number; height?: number }) {
+  return (
+    <div aria-busy="true" aria-label="Chargement" style={{ display: "flex", flexDirection: "column", gap: 10 }}>
+      {Array.from({ length: rows }).map((_, i) => (
+        <div key={i} className="skeleton" style={{ height, borderRadius: 16 }} />
+      ))}
+    </div>
+  );
+}
+
+/* ── Bouton icône rond (en-têtes) ─────────────────────────────── */
+export function HeaderButton({
+  onClick,
+  label,
+  children,
+  filled,
+}: {
+  onClick: () => void;
+  label: string;
+  children: ReactNode;
+  filled?: boolean;
+}) {
+  return (
+    <button
+      type="button"
+      onClick={() => {
+        haptic(8);
+        onClick();
+      }}
+      aria-label={label}
+      className="tap"
+      style={{ ...iconButton, color: filled ? "#000" : c.text, background: filled ? "#FFF" : "transparent", width: filled ? 36 : 44, height: filled ? 36 : 44, margin: filled ? 4 : 0 }}
+    >
+      {children}
+    </button>
+  );
+}
+
+export function PlusIcon({ size = 22 }: { size?: number }) {
+  return (
+    <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.6" strokeLinecap="round" aria-hidden="true">
+      <path d="M12 5v14M5 12h14" />
+    </svg>
+  );
+}
+
+/* ── Champ de formulaire (label + input) ──────────────────────── */
+export function Field({ id, label, hint, children, style }: { id?: string; label: string; hint?: ReactNode; children: ReactNode; style?: CSSProperties }) {
+  return (
+    <div style={{ marginBottom: 16, ...style }}>
+      <label htmlFor={id} style={labelStyle}>{label}</label>
+      {children}
+      {hint && <div style={{ fontSize: 13, color: c.text3, marginTop: 6, paddingLeft: 4 }}>{hint}</div>}
+    </div>
+  );
+}
+
+export { inputStyle };
+
+/* ── Grille de choix d'emoji ──────────────────────────────────── */
+export function EmojiPicker({ value, onChange, emojis }: { value: string; onChange: (e: string) => void; emojis: string[] }) {
+  return (
+    <div role="radiogroup" aria-label="Icône" style={{ display: "grid", gridTemplateColumns: "repeat(auto-fill, minmax(44px, 1fr))", gap: 6 }}>
+      {emojis.map((e) => {
+        const active = value === e;
+        return (
+          <button
+            key={e}
+            type="button"
+            role="radio"
+            aria-checked={active}
+            onClick={() => {
+              haptic(6);
+              onChange(e);
+            }}
+            className="tap"
+            style={{
+              height: 44,
+              borderRadius: 12,
+              background: active ? c.card3 : c.card2,
+              border: active ? "2px solid #FFF" : "2px solid transparent",
+              fontSize: 22,
+              cursor: "pointer",
+            }}
+          >
+            {e}
+          </button>
+        );
+      })}
