diff --git a/src/store/dataStore.ts b/src/store/dataStore.ts
new file mode 100644
index 0000000..40b5dcb
--- /dev/null
+++ b/src/store/dataStore.ts
@@ -0,0 +1,98 @@
+"use client";
+// Cache mémoire partagé entre les onglets : on ne recharge plus tout
+// (ni n'affiche « Chargement… ») à chaque changement d'onglet.
+// Première visite → fetch ; visites suivantes → affichage instantané
+// + revalidation silencieuse en arrière-plan.
+
+import { create } from "zustand";
+import { useEffect } from "react";
+import { getMemories, getUser, type Memory } from "@/lib/firestore";
+import { useAuthStore } from "./authStore";
+
+interface DataStore {
+  memories: Memory[];
+  memoriesLoaded: boolean;
+  memoriesLoading: boolean;
+  partnerBirthday: Date | null;
+  partnerLoaded: boolean;
+  refreshMemories: () => Promise<void>;
+  loadPartner: (partnerId: string) => Promise<void>;
+  reset: () => void;
+}
+
+export const useDataStore = create<DataStore>((set, get) => ({
+  memories: [],
+  memoriesLoaded: false,
+  memoriesLoading: false,
+  partnerBirthday: null,
+  partnerLoaded: false,
+
+  refreshMemories: async () => {
+    if (get().memoriesLoading) return;
+    set({ memoriesLoading: true });
+    try {
+      const memories = await getMemories();
+      set({ memories, memoriesLoaded: true });
+    } catch (e) {
+      console.error(e);
+      set({ memoriesLoaded: true });
+    } finally {
+      set({ memoriesLoading: false });
+    }
+  },
+
+  loadPartner: async (partnerId) => {
+    if (get().partnerLoaded) return;
+    try {
+      const data = await getUser(partnerId);
+      let partnerBirthday: Date | null = null;
+      if (data?.birthday) {
+        const d = data.birthday.toDate();
+        partnerBirthday = new Date(d.getFullYear(), d.getMonth(), d.getDate());
+      }
+      set({ partnerBirthday, partnerLoaded: true });
+    } catch {
+      set({ partnerLoaded: true });
+    }
+  },
+
+  reset: () => set({ memories: [], memoriesLoaded: false, partnerBirthday: null, partnerLoaded: false }),
+}));
+
+// Revalidation : au plus une fois toutes les 30 s lors d'un montage d'écran.
+let lastFetch = 0;
+
+/** Souvenirs partagés + état de chargement. */
+export function useMemories() {
+  const user = useAuthStore((s) => s.user);
+  const memories = useDataStore((s) => s.memories);
+  const loaded = useDataStore((s) => s.memoriesLoaded);
+  const refresh = useDataStore((s) => s.refreshMemories);
+
+  useEffect(() => {
+    if (!user) return;
+    if (Date.now() - lastFetch < 30_000 && useDataStore.getState().memoriesLoaded) return;
+    lastFetch = Date.now();
+    refresh();
+  }, [user, refresh]);
+
+  return {
+    memories,
+    loading: !loaded,
+    refresh: async () => {
+      lastFetch = Date.now();
+      await refresh();
+    },
+  };
+}
+
+/** Anniversaire du/de la partenaire (chargé une fois). */
+export function usePartnerBirthday() {
+  const user = useAuthStore((s) => s.user);
+  const birthday = useDataStore((s) => s.partnerBirthday);
+  const load = useDataStore((s) => s.loadPartner);
+  useEffect(() => {
+    if (user?.partnerId) load(user.partnerId);
+  }, [user?.partnerId, load]);
+  return birthday;
+}
