+
+type Props = {
+  title: ReactNode;
+  eyebrow?: ReactNode;
+  subtitle?: ReactNode;
+  /** Sous-page : lien retour (« ‹ Plus ») */
+  back?: { href: string; label: string };
+  /** Actions à droite (boutons icône) */
+  right?: ReactNode;
+  /** Contenu sous le titre (segmented control, filtres…) */
+  children?: ReactNode;
+  /** Pas de bordure basse (ex. la carte) */
+  bare?: boolean;
+};
+
+/** En-tête d'écran : safe-area, titre large serif, actions à portée. */
+export default function PageHeader({ title, eyebrow, subtitle, back, right, children, bare }: Props) {
