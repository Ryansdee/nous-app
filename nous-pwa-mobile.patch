+    }
+    return [...map.entries()].sort((a, b) => b[0] - a[0]);
+  }, [memories]);
+
+  const feedGroups = useMemo(() => {
+    const list = yearFilter === "all" ? memories : memories.filter((m) => m.date.getFullYear() === yearFilter);
+    const sorted = [...list].sort((a, b) => b.date.getTime() - a.date.getTime());
+    const groups = new Map<string, Memory[]>();
+    for (const m of sorted) {
+      const key = `${m.date.getFullYear()}-${m.date.getMonth()}-${m.date.getDate()}|${m.title.trim().toLowerCase()}`;
+      if (!groups.has(key)) groups.set(key, []);
+      groups.get(key)!.push(m);
+    }
+    return [...groups.entries()];
+  }, [memories, yearFilter]);
+
+  const todayMemory = useMemo(() => {
+    const now = new Date();
+    return memories.find((m) => m.date.getMonth() === now.getMonth() && m.date.getDate() === now.getDate() && m.date.getFullYear() < now.getFullYear());
+  }, [memories]);
+
+  async function saveWord() {
+    if (!wordFor || !wordText.trim()) return;
+    setWordSaving(true);
+    try {
+      await addWordToMemory(wordFor.id, user.name, wordText.trim());
+      haptic([10, 30, 10]);
+      await refresh();
+      setWordFor(null);
+      setWordText("");
+      showToast("Mot ajouté");
+    } catch {
+      showToast("Impossible d'enregistrer ton mot", "error");
+    } finally {
+      setWordSaving(false);
+    }
+  }
+
+  const daysTogether = daysSince(TOGETHER_SINCE);
+  const untilAnniv = daysUntilNext(TOGETHER_SINCE);
+  const partnerName = partnerNameOf(user.name);
+
+  return (
+    <Screen
+      onRefresh={refresh}
+      header={
+        <PageHeader
+          title={
+            <>
+              Nous <span aria-hidden="true" style={{ color: c.pink, fontSize: 20 }}>✦</span>
+            </>
+          }
+          subtitle={`${daysTogether.toLocaleString("fr-BE")} jours ensemble · ${untilAnniv === 0 ? "💍 c'est votre anniversaire !" : `💍 dans ${untilAnniv} j`}`}
+        />
+      }
+    >
+      {/* Années façon « stories » */}
+      {yearStories.length > 0 && (
+        <div role="group" aria-label="Filtrer par année" className="scroll-x" style={{ display: "flex", gap: 14, padding: "14px 16px", borderBottom: `0.5px solid ${c.separator}` }}>
+          <StoryBubble label="Ajouter" onClick={openAdd} dashed>
+            <span style={{ fontSize: 30, color: c.text3, fontWeight: 300 }}>+</span>
+          </StoryBubble>
+          <StoryBubble label="Tout" active={yearFilter === "all"} onClick={() => setYearFilter("all")}>
+            <span style={{ fontSize: 22 }}>✦</span>
+          </StoryBubble>
+          {yearStories.map(([year, cover]) => (
+            <StoryBubble key={year} label={String(year)} active={yearFilter === year} onClick={() => setYearFilter(yearFilter === year ? "all" : year)}>
+              {photosOf(cover)[0] ? (
+                // eslint-disable-next-line @next/next/no-img-element
+                <img src={photosOf(cover)[0]} alt="" loading="lazy" style={{ width: "100%", height: "100%", objectFit: "cover" }} />
+              ) : (
+                <span style={{ fontSize: 18, color: c.text3 }}>{String(year).slice(2)}</span>
+              )}
+            </StoryBubble>
+          ))}
+        </div>
+      )}
+
+      {todayMemory && yearFilter === "all" && (
+        <div style={{ margin: "16px 16px 0", background: c.card, borderRadius: 16, padding: 14, display: "flex", gap: 12, alignItems: "center" }}>
+          {photosOf(todayMemory)[0] && (
+            // eslint-disable-next-line @next/next/no-img-element
+            <img src={photosOf(todayMemory)[0]} alt="" loading="lazy" style={{ width: 56, height: 56, borderRadius: 12, objectFit: "cover", flexShrink: 0 }} />
+          )}
+          <div style={{ minWidth: 0 }}>
+            <p style={{ fontSize: 12, color: c.yellow, fontWeight: 700, textTransform: "uppercase", letterSpacing: 0.5 }}>
+              Ce jour-là · il y a {new Date().getFullYear() - todayMemory.date.getFullYear()} an
+              {new Date().getFullYear() - todayMemory.date.getFullYear() > 1 ? "s" : ""}
+            </p>
+            <p style={{ fontSize: 16, fontWeight: 600, overflow: "hidden", textOverflow: "ellipsis", whiteSpace: "nowrap" }}>{todayMemory.title}</p>
+            <p style={{ fontSize: 14, color: c.text2 }}>{todayMemory.location}</p>
+          </div>
+        </div>
+      )}
+
+      <MemoryPreview memories={memories} />
+
+      <div style={{ marginTop: 16 }}>
+        {loading ? (
+          <div aria-busy="true" style={{ display: "flex", flexDirection: "column", gap: 16 }}>
+            {[0, 1].map((i) => (
+              <div key={i}>
+                <div style={{ display: "flex", gap: 10, padding: "10px 16px" }}>
+                  <div className="skeleton" style={{ width: 36, height: 36, borderRadius: "50%" }} />
+                  <div className="skeleton" style={{ flex: 1, height: 36, borderRadius: 8 }} />
+                </div>
+                <div className="skeleton" style={{ width: "100%", aspectRatio: "4 / 5" }} />
+              </div>
+            ))}
+          </div>
+        ) : feedGroups.length === 0 ? (
+          <EmptyState
+            icon="📸"
+            title={yearFilter === "all" ? "Aucun souvenir encore" : `Aucun souvenir en ${yearFilter}`}
+            text="Touchez le + en bas pour ajouter votre premier moment."
+          />
+        ) : (
+          feedGroups.map(([key, items]) => (
+            <FeedPost
+              key={key}
+              items={items}
+              isLiked={liked.has(items[0].id)}
+              onToggleLike={(force) => toggleLike(items[0].id, force)}
+              myName={user.name}
+              onAddWord={(m) => {
+                setWordText("");
+                setWordFor(m);
+              }}
+            />
+          ))
+        )}
+      </div>
+
+      <Sheet
+        open={!!wordFor}
+        onClose={() => setWordFor(null)}
+        eyebrow={wordFor?.title}
+        title="Mon mot"
+        locked={wordSaving}
+        footer={
+          <button type="button" onClick={saveWord} disabled={wordSaving || !wordText.trim()} className="tap" style={primaryButton}>
+            {wordSaving ? "Enregistrement…" : "Ajouter"}
+          </button>
+        }
+      >
+        <label htmlFor="word-input" className="sr-only">Ton mot</label>
+        <textarea
+          id="word-input"
+          value={wordText}
+          onChange={(e) => setWordText(e.target.value)}
+          placeholder={`Ce que ce moment signifie pour toi… (${partnerName} le verra)`}
+          rows={4}
+          autoFocus
+          style={{ ...input, resize: "none", lineHeight: 1.45 }}
+        />
+      </Sheet>
+    </Screen>
+  );
+}
+
+function StoryBubble({
+  label,
+  active,
+  dashed,
+  onClick,
+  children,
+}: {
+  label: string;
+  active?: boolean;
+  dashed?: boolean;
+  onClick: () => void;
+  children: React.ReactNode;
+}) {
+  return (
+    <button
+      type="button"
+      onClick={() => {
+        haptic(6);
+        onClick();
+      }}
+      aria-pressed={dashed ? undefined : !!active}
+      className="tap"
+      style={{ flexShrink: 0, display: "flex", flexDirection: "column", alignItems: "center", gap: 6, background: "none", border: "none", cursor: "pointer", padding: 0, width: 66 }}
+    >
+      <span
+        style={{
+          width: 66,
+          height: 66,
+          borderRadius: "50%",
+          padding: 3,
+          background: active ? "linear-gradient(45deg,#FF2D55,#FFD60A,#0A84FF)" : "transparent",
+          border: active ? "none" : dashed ? "2px dashed #48484A" : "2px solid #3A3A3C",
+          display: "block",
+        }}
+      >
+        <span
+          style={{
+            width: "100%",
+            height: "100%",
+            borderRadius: "50%",
+            overflow: "hidden",
+            background: dashed ? "transparent" : c.card2,
+            border: active ? "2px solid #000" : "none",
+            display: "flex",
+            alignItems: "center",
+            justifyContent: "center",
+          }}
+        >
+          {children}
+        </span>
+      </span>
+      <span style={{ fontSize: 12, color: active ? "#FFF" : c.text2, fontWeight: active ? 600 : 400 }}>{label}</span>
+    </button>
+  );
+}
